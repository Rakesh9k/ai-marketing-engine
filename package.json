{
  "name": "ai-marketing-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:emulators": "firebase emulators:start",
    "functions:build": "npm --prefix functions run build",
    "functions:serve": "npm --prefix functions run serve",
    "functions:deploy": "npm --prefix functions run deploy",
    "functions:logs": "npm --prefix functions run logs",
    "functions:lint": "npm --prefix functions run lint",
    "functions:typecheck": "npm --prefix functions run typecheck",
    "functions:test": "npm --prefix functions run test",
    "postinstall": "npm --prefix functions install"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "firebase": "^10.12.5",
    "next": "15.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^2.0.7",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/testing-library__jest-dom": "^5.14.9",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.2.4",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": "20.x"
  },
  "packageManager": "npm@11.12.1"
}
