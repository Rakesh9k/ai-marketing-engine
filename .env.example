# =============================================================================
# AI MARKETING ENGINE - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file with real secrets
# =============================================================================

# -----------------------------------------------------------------------------
# FIREBASE CONFIGURATION (Client-side - Public)
# -----------------------------------------------------------------------------
# Get these from Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# -----------------------------------------------------------------------------
# FIREBASE APP CHECK (Client-side - Public, but must match a real registration)
# -----------------------------------------------------------------------------
# Phase 20A: every Cloud Function is deployed with enforceAppCheck: true. Without
# this, every callable request fails with UNAUTHENTICATED regardless of a valid
# auth token (App Check and Auth are verified independently). Register a
# reCAPTCHA Enterprise site key for this exact site at
# https://console.firebase.google.com/project/_/appcheck > Apps > Web app >
# reCAPTCHA Enterprise, then set it here. (Phase 20C: this project's App Check
# registration flow produces an Enterprise key, not classic reCAPTCHA v3 — the
# client code uses ReCaptchaEnterpriseProvider accordingly.)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-enterprise-site-key

# Optional: a debug token registered in Firebase Console > App Check > Apps >
# this web app > Manage debug tokens. Only used when NEXT_PUBLIC_USE_EMULATORS
# is true (local dev / CI, where reCAPTCHA cannot validate the origin); leave
# unset to let the SDK generate and log a token on first run, then register
# that one.
# NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=your-debug-token

# -----------------------------------------------------------------------------
# FIREBASE ADMIN (Server-side - Secret)
# -----------------------------------------------------------------------------
# Set these in Firebase Functions secrets: firebase functions:secrets:set
# FIREBASE_ADMIN_PROJECT_ID=your-project-id
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# AI PROVIDER KEYS (Server-side - Secret)
# -----------------------------------------------------------------------------
# Set these in Firebase Functions secrets
# GEMINI_API_KEY=your-gemini-api-key
# (OpenAI is no longer used; image generation runs on Gemini via GEMINI_API_KEY. Optional: GEMINI_IMAGE_MODEL, default gemini-2.5-flash-image)
# NVIDIA_API_KEY=your-nvidia-api-key

# Architected but NOT YET CONFIGURED (see docs/AI_ARCHITECTURE.md) — the
# corresponding provider under functions/src/services/ai/providers/ throws
# a clear "not configured" error until a real key is set here. Do not set
# a placeholder/fake value.
# VEO_API_KEY=
# ELEVENLABS_API_KEY=
# PHOTOROOM_API_KEY=

# Model routing configuration (optional - defaults shown)
# TEXT_MODEL_PRIMARY=nemotron-3-ultra
# TEXT_MODEL_FALLBACK=gemini-1.5-pro
# VISION_MODEL_PRIMARY=gemini-1.5-pro-vision
# VISION_MODEL_FALLBACK=gpt-4o-vision
# IMAGE_MODEL_PRIMARY=dall-e-3
# IMAGE_MODEL_FALLBACK=gemini-imagen
# EMBEDDING_MODEL_PRIMARY=text-embedding-3-small
# EMBEDDING_MODEL_FALLBACK=gemini-embedding

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AI Marketing Engine"

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_SALON_VERTICAL=false
NEXT_PUBLIC_ENABLE_REAL_ESTATE_VERTICAL=false
NEXT_PUBLIC_ENABLE_WHATSAPP_API=false
NEXT_PUBLIC_ENABLE_AGENCY_WORKSPACE=false

# -----------------------------------------------------------------------------
# PADDLE BILLING (Payments & Subscriptions)
# -----------------------------------------------------------------------------
# The Paddle environment is ALWAYS explicit — there is no default. A missing or inconsistent
# value fails loudly (client: src/lib/paddle/config.ts, server: services/paddle.ts), so
# production code can never silently talk to sandbox, or the reverse.

# --- Client (Next.js, public by design; Paddle.js requires them) ---
# 'sandbox' or 'production'.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Client-side token from Paddle > Developer tools > Authentication. Sandbox tokens start with
# 'test_', live tokens with 'live_'; a mismatch with the environment above is rejected.
# This is NOT the API key. Never put a 'pdl_' key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Price IDs (not secrets) — printed by scripts/setup-paddle-catalog.mjs. The browser needs them
# to request localized prices; the server resolves its own copy at checkout and the client
# refuses to open checkout if the two disagree.
NEXT_PUBLIC_PADDLE_PRICE_ID_STARTER_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_STARTER_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_BUSINESS_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_BUSINESS_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_AGENCY_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_AGENCY_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_PACK_500=
NEXT_PUBLIC_PADDLE_PRICE_ID_PACK_1200=
NEXT_PUBLIC_PADDLE_PRICE_ID_PACK_3000=

# --- Server (Firebase Functions) — secrets, never NEXT_PUBLIC_*, never committed ---
#   firebase functions:secrets:set PADDLE_API_KEY
#   firebase functions:secrets:set PADDLE_WEBHOOK_SECRET
# PADDLE_API_KEY=            # sandbox keys start 'pdl_sdbx_', live keys 'pdl_live_'
# PADDLE_WEBHOOK_SECRET=
# Required, no default; must agree with the API key above:
# PADDLE_ENVIRONMENT=sandbox

# Functions-side price IDs (same values as above, without the NEXT_PUBLIC_ prefix). Generate
# both blocks with the idempotent catalog script, which reads prices from
# functions/src/config/pricing.ts:
#   npm --prefix functions run build
#   PADDLE_API_KEY=... node scripts/setup-paddle-catalog.mjs            # dry run
#   PADDLE_API_KEY=... node scripts/setup-paddle-catalog.mjs --apply
# A missing price ID makes that purchase fail closed — there is no mock fallback.
# PADDLE_PRICE_ID_STARTER_MONTHLY=
# PADDLE_PRICE_ID_STARTER_YEARLY=
# PADDLE_PRICE_ID_BUSINESS_MONTHLY=
# PADDLE_PRICE_ID_BUSINESS_YEARLY=
# PADDLE_PRICE_ID_PRO_MONTHLY=
# PADDLE_PRICE_ID_PRO_YEARLY=
# PADDLE_PRICE_ID_AGENCY_MONTHLY=
# PADDLE_PRICE_ID_AGENCY_YEARLY=
# PADDLE_PRICE_ID_PACK_500=
# PADDLE_PRICE_ID_PACK_1200=
# PADDLE_PRICE_ID_PACK_3000=

# -----------------------------------------------------------------------------
# DEVELOPMENT / EMULATOR SETTINGS
# -----------------------------------------------------------------------------
# Set to 'true' when running against Firebase Emulators
NEXT_PUBLIC_USE_EMULATORS=false

# Emulator hosts (when USE_EMULATORS=true)
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
# FIREBASE_FUNCTIONS_EMULATOR_HOST=localhost:5001