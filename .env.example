# =============================================================================
# AI MARKETING ENGINE - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file with real secrets
# =============================================================================

# -----------------------------------------------------------------------------
# FIREBASE CONFIGURATION (Client-side - Public)
# -----------------------------------------------------------------------------
# Get these from Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# -----------------------------------------------------------------------------
# FIREBASE ADMIN (Server-side - Secret)
# -----------------------------------------------------------------------------
# Set these in Firebase Functions secrets: firebase functions:secrets:set
# FIREBASE_ADMIN_PROJECT_ID=your-project-id
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# AI PROVIDER KEYS (Server-side - Secret)
# -----------------------------------------------------------------------------
# Set these in Firebase Functions secrets
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# NVIDIA_API_KEY=your-nvidia-api-key

# Model routing configuration (optional - defaults shown)
# TEXT_MODEL_PRIMARY=nemotron-3-ultra
# TEXT_MODEL_FALLBACK=gemini-1.5-pro
# VISION_MODEL_PRIMARY=gemini-1.5-pro-vision
# VISION_MODEL_FALLBACK=gpt-4o-vision
# IMAGE_MODEL_PRIMARY=dall-e-3
# IMAGE_MODEL_FALLBACK=gemini-imagen
# EMBEDDING_MODEL_PRIMARY=text-embedding-3-small
# EMBEDDING_MODEL_FALLBACK=gemini-embedding

# -----------------------------------------------------------------------------
# RAZORPAY CONFIGURATION
# -----------------------------------------------------------------------------
# Public key - safe for client
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# Secret keys - ONLY in Firebase Functions secrets
# RAZORPAY_KEY_SECRET=your-razorpay-secret
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AI Marketing Engine"

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_SALON_VERTICAL=false
NEXT_PUBLIC_ENABLE_REAL_ESTATE_VERTICAL=false
NEXT_PUBLIC_ENABLE_WHATSAPP_API=false
NEXT_PUBLIC_ENABLE_AGENCY_WORKSPACE=false

# -----------------------------------------------------------------------------
# DEVELOPMENT / EMULATOR SETTINGS
# -----------------------------------------------------------------------------
# Set to 'true' when running against Firebase Emulators
NEXT_PUBLIC_USE_EMULATORS=false

# Emulator hosts (when USE_EMULATORS=true)
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
# FIREBASE_FUNCTIONS_EMULATOR_HOST=localhost:5001