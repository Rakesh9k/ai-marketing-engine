# =============================================================================
# MITRA - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real secrets.
# This file lists variable NAMES with safe placeholders only.
#
# Where each group lives (see "Where to set it" per section):
#   .env.local                      -> local Next.js dev (frontend)
#   apphosting.yaml                 -> production frontend (Firebase App Hosting, backend `mitra-web`)
#   Vercel project env              -> preview/staging frontend (vercel.json)
#   functions/.env.<project-id>     -> NON-secret Cloud Functions params (gitignored, picked up at deploy)
#   functions/.env.local            -> Functions emulator only (gitignored)
#   firebase functions:secrets:set  -> Cloud Functions secrets
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time:
# they are public by design and must be available at build, not just runtime.
# Legend:  [dev] required for local dev   [prod] required for production
# =============================================================================

# -----------------------------------------------------------------------------
# FIREBASE WEB CONFIG   (public)   Where: .env.local / apphosting.yaml / Vercel
# [dev] [prod]  Firebase Console > Project Settings > General > Your apps
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
# Optional (Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# -----------------------------------------------------------------------------
# FIREBASE APP CHECK   (public)
# -----------------------------------------------------------------------------
# Every Cloud Function is deployed with enforceAppCheck: true. Without a valid
# site key every callable fails with UNAUTHENTICATED even with a valid auth token.
# Register a reCAPTCHA Enterprise key for this exact site in Firebase Console >
# App Check > Apps > Web app (the client uses ReCaptchaEnterpriseProvider).
# [prod] required (BUILD availability in apphosting.yaml)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY
# Optional, local dev / CI only: a debug token registered in Firebase Console >
# App Check > Manage debug tokens. Only read when NEXT_PUBLIC_USE_EMULATORS=true.
# Leave unset to let the SDK generate one on first run. Deliberately NOT in
# apphosting.yaml.
# NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=YOUR_DEBUG_TOKEN

# -----------------------------------------------------------------------------
# EMULATORS   (public)
# -----------------------------------------------------------------------------
# 'true' wires the browser to the local Firebase emulators (127.0.0.1:9099 auth,
# 8080 firestore, 9199 storage, 5001 functions) and shows a warning banner.
# Production MUST be 'false' (apphosting.yaml sets it explicitly).
NEXT_PUBLIC_USE_EMULATORS=false
# The emulator ports/hosts are fixed in firebase.json and in src/lib/firebase/client.ts;
# no FIREBASE_*_EMULATOR_HOST variable is read by the app. (The Firebase CLI sets
# its own for the Functions emulator, including FIREBASE_STORAGE_EMULATOR_HOST.)

# -----------------------------------------------------------------------------
# PADDLE BILLING - CLIENT   (public by design; Paddle.js needs them)
# -----------------------------------------------------------------------------
# The environment is ALWAYS explicit - there is no default. A missing or
# inconsistent value fails loudly (client: src/lib/paddle/config.ts, server:
# functions/src/services/paddle.ts) so production can never silently use sandbox.
# [dev] [prod]
# 'sandbox' or 'production'.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Client-side token (Paddle > Developer tools > Authentication). Sandbox tokens
# start with 'test_', live with 'live_'; a mismatch with the environment is
# rejected. This is NOT the API key - never put a 'pdl_' key in a NEXT_PUBLIC_ var.
# In production these are Secret Manager references in apphosting.yaml
# (secret ID == variable name); create with `firebase apphosting:secrets:set <NAME>`.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=YOUR_PADDLE_CLIENT_TOKEN
# Price IDs (not secrets). Printed by scripts/setup-paddle-catalog.mjs. The client
# refuses to open checkout if its copy disagrees with the server's.
NEXT_PUBLIC_PADDLE_PRICE_ID_STARTER_MONTHLY=YOUR_PRICE_ID
NEXT_PUBLIC_PADDLE_PRICE_ID_STARTER_YEARLY=YOUR_PRICE_ID
NEXT_PUBLIC_PADDLE_PRICE_ID_BUSINESS_MONTHLY=YOUR_PRICE_ID
NEXT_PUBLIC_PADDLE_PRICE_ID_BUSINESS_YEARLY=YOUR_PRICE_ID
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO_MONTHLY=YOUR_PRICE_ID
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO_YEARLY=YOUR_PRICE_ID
NEXT_PUBLIC_PADDLE_PRICE_ID_AGENCY_MONTHLY=YOUR_PRICE_ID
NEXT_PUBLIC_PADDLE_PRICE_ID_AGENCY_YEARLY=YOUR_PRICE_ID
NEXT_PUBLIC_PADDLE_PRICE_ID_PACK_500=YOUR_PRICE_ID
NEXT_PUBLIC_PADDLE_PRICE_ID_PACK_1200=YOUR_PRICE_ID
NEXT_PUBLIC_PADDLE_PRICE_ID_PACK_3000=YOUR_PRICE_ID

# -----------------------------------------------------------------------------
# MONITORING - SENTRY   (frontend; all optional, Sentry is disabled when unset)
# -----------------------------------------------------------------------------
# Read by src/instrumentation.ts, src/instrumentation-client.ts, next.config.ts.
# NOT currently present in apphosting.yaml: set them there (or in Vercel) if
# production error reporting is wanted.
# Public (browser DSN):
# NEXT_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
# Server/edge DSN:
# SENTRY_DSN=YOUR_SENTRY_DSN
# Release tag and environment label (falls back to NODE_ENV):
# NEXT_PUBLIC_SENTRY_RELEASE=replace_with_release_id
# NEXT_PUBLIC_VERCEL_ENV=preview
# Source-map upload at build time (SECRET auth token - build environment only):
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=YOUR_SECRET_HERE

# -----------------------------------------------------------------------------
# E2E TESTS (Playwright)
# -----------------------------------------------------------------------------
# Optional; defaults to http://localhost:3000. See tests/e2e/.
# E2E_BASE_URL=http://localhost:3000

# =============================================================================
# CLOUD FUNCTIONS  (server-side; NEVER NEXT_PUBLIC_*, never in .env.local of the
# frontend, never committed)
# =============================================================================
# Validated in functions/src/config/env.ts. Secrets are bound per function via
# `secrets: [...]`; set each with:  firebase functions:secrets:set NAME
# For the Functions EMULATOR only, put them in functions/.env.local (gitignored).

# --- AI ----------------------------------------------------------------------
# SECRET. Bound by generateCampaignStrategy, createCampaignFromCalendarItem,
# regenerateAsset, generateReel, analyzeReferenceStyle.
# [dev] needed for real AI output  [prod] required
# GEMINI_API_KEY=YOUR_SECRET_HERE
# Optional (non-secret) overrides. Image generation runs on Gemini; default shown.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Optional model routing (functions/src/config/modelRouting.ts). Code defaults are
# gemini-1.5-pro for text/vision, 'dall-e-3' for image primary and
# 'text-embedding-3-small' for embedding primary. The two non-Gemini defaults are
# legacy OpenAI names left in code; set the IMAGE_/EMBEDDING_ values explicitly
# if those routes are exercised.
# TEXT_MODEL_PRIMARY=
# TEXT_MODEL_FALLBACK=
# VISION_MODEL_PRIMARY=
# VISION_MODEL_FALLBACK=
# IMAGE_MODEL_PRIMARY=
# IMAGE_MODEL_FALLBACK=
# EMBEDDING_MODEL_PRIMARY=
# EMBEDDING_MODEL_FALLBACK=
# Declared in config/env.ts but NOT read by any code today (architected, see
# docs/AI_ARCHITECTURE.md): NVIDIA_API_KEY, VEO_API_KEY, ELEVENLABS_API_KEY,
# PHOTOROOM_API_KEY. Do not set placeholder values for them.

# --- PADDLE (server) ---------------------------------------------------------
#   firebase functions:secrets:set PADDLE_API_KEY
#   firebase functions:secrets:set PADDLE_WEBHOOK_SECRET
# SECRET. Bound by createPaddleCheckout, cancelPaddleSubscription, paddleWebhook.
# [prod] required
# PADDLE_API_KEY=YOUR_SECRET_HERE
# PADDLE_WEBHOOK_SECRET=YOUR_SECRET_HERE
# NON-secret param, required, no default; must agree with the API key prefix.
# One Functions deployment talks to exactly one Paddle environment.
# PADDLE_ENVIRONMENT=sandbox
# NON-secret price IDs (same values as the NEXT_PUBLIC_ block, no prefix).
# A missing ID makes that purchase fail closed (no mock fallback).
# PADDLE_PRICE_ID_STARTER_MONTHLY=YOUR_PRICE_ID
# PADDLE_PRICE_ID_STARTER_YEARLY=YOUR_PRICE_ID
# PADDLE_PRICE_ID_BUSINESS_MONTHLY=YOUR_PRICE_ID
# PADDLE_PRICE_ID_BUSINESS_YEARLY=YOUR_PRICE_ID
# PADDLE_PRICE_ID_PRO_MONTHLY=YOUR_PRICE_ID
# PADDLE_PRICE_ID_PRO_YEARLY=YOUR_PRICE_ID
# PADDLE_PRICE_ID_AGENCY_MONTHLY=YOUR_PRICE_ID
# PADDLE_PRICE_ID_AGENCY_YEARLY=YOUR_PRICE_ID
# PADDLE_PRICE_ID_PACK_500=YOUR_PRICE_ID
# PADDLE_PRICE_ID_PACK_1200=YOUR_PRICE_ID
# PADDLE_PRICE_ID_PACK_3000=YOUR_PRICE_ID

# --- META (Facebook / Instagram OAuth & publishing) --------------------------
# Needed only if the Meta integration is used.
# SECRETS (bound by initiateMetaOAuth, metaCallback, selectMetaPage):
# META_APP_SECRET=YOUR_SECRET_HERE
# META_TOKEN_ENCRYPTION_KEY=YOUR_SECRET_HERE
#   WARNING: if this is unset, functions/src/services/meta/crypto.ts silently
#   derives the AES key from GCLOUD_PROJECT (a non-secret value). That fallback
#   is for tests/emulator only - production MUST set a real random key.
# Non-secret params:
# META_APP_ID=YOUR_META_APP_ID
# META_REDIRECT_URI=https://REGION-PROJECT_ID.cloudfunctions.net/metaCallback
#   (code default is a localhost emulator URL)
# META_GRAPH_API_VERSION=v20.0
# Where metaCallback redirects the browser afterwards (default http://localhost:3000):
# APP_URL=https://your-production-domain.example

# --- REEL RENDERER (Cloud Run ffmpeg service, services/reel-renderer) --------
# Unset in local/emulator dev: functions/src/services/videoRenderer.ts then uses
# a deterministic mock renderer. Required for real reels in production.
# REEL_RENDERER_URL=https://your-reel-renderer.example
# SECRET shared with the renderer service (same name read by services/reel-renderer):
# REEL_RENDERER_API_KEY=YOUR_SECRET_HERE
# Renderer-only (services/reel-renderer): PORT (default 8080), FFMPEG_PATH,
# FFPROBE_PATH, DRAWTEXT_FONTS_DIR, DRAWTEXT_FONT_LATIN, DRAWTEXT_FONT_DEVANAGARI,
# DRAWTEXT_FONT_TELUGU (container defaults are set in its Dockerfile).

# --- PROJECT / RUNTIME (set by the platform; usually do not set manually) -----
# FIREBASE_PROJECT_ID or GCLOUD_PROJECT (required by config/env.ts), FUNCTIONS_EMULATOR,
# K_REVISION, NODE_ENV. FIREBASE_REGION is declared (default asia-south1) but not read.

# --- LEGACY / DISABLED PAYMENT PROVIDERS (not exported from functions/src/index.ts) --
# PayU and Razorpay code is kept for rollback only; their functions are not
# deployed. Do not configure these unless re-enabling (docs/PAYMENT_GATEWAY.md):
#   PayU:     PAYU_MERCHANT_KEY, PAYU_SALT (secret), PAYU_ENVIRONMENT, PAYU_SI_ENABLED,
#             PAYU_CALLBACK_URL, PAYU_WEBHOOK_URL (declared, unused)
#   Razorpay: RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET,
#             RAZORPAY_{STARTER,BUSINESS,AGENCY}_PLAN_ID
# Declared but never read: ADMIN_EMAILS.

# =============================================================================
# REMOVED (stale - documented previously, read by no code; safe to delete from
# any existing .env.local): NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_APP_NAME,
# NEXT_PUBLIC_RAZORPAY_KEY_ID, NEXT_PUBLIC_ENABLE_SALON_VERTICAL,
# NEXT_PUBLIC_ENABLE_REAL_ESTATE_VERTICAL, NEXT_PUBLIC_ENABLE_WHATSAPP_API,
# NEXT_PUBLIC_ENABLE_AGENCY_WORKSPACE, FIREBASE_ADMIN_PROJECT_ID,
# FIREBASE_ADMIN_CLIENT_EMAIL, FIREBASE_ADMIN_PRIVATE_KEY, OPENAI_API_KEY,
# FIREBASE_{AUTH,FIRESTORE,FUNCTIONS}_EMULATOR_HOST.
# =============================================================================

# Conversational onboarding (/onboarding/v2). Leave "false" until its launch gates are cleared:
# a real Google sign-in/consent check and a real Gemini call (docs/ONBOARDING_DRAFT_MODEL.md).
# "true" sends new owners to the conversation instead of the original wizard. Needs a rebuild.
NEXT_PUBLIC_ONBOARDING_V2=false

# Gemini models (code defaults live in functions/src/config/geminiModels.ts; chosen by benchmark, see
# docs/MODEL_BENCHMARK_2026-10.md). The old default gemini-1.5-flash is RETIRED (404). Leave these unset to use
# the defaults, or set them per environment to override without a code change. Verify any override with a tiny
# live call first; never point production at a model you have not called.
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite        # campaigns, copy, planning, regeneration (pinned)
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite      # photo + reference-style analysis
# GEMINI_DISCOVERY_MODEL=gemini-flash-lite-latest  # onboarding discovery (free, 20s cutoff; alias)
