{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        "node_modules/**",
        ".git",
        ".git/**",
        "*.local",
        "*.log",
        "*.test.ts",
        "*.spec.ts",
        "**/__tests__/**",
        "coverage",
        "coverage/**",
        "test-results",
        "test-results/**",
        "test-output-reel",
        "test-output-reel/**",
        ".runtimeconfig.json"
      ],
      "predeploy": ["npm --prefix functions run build"]
    }
  ],
  "apphosting": {
    "backendId": "mitra-web",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      "node_modules/**",
      "functions",
      "functions/**",
      "services/reel-renderer",
      "services/reel-renderer/**",
      ".git",
      ".git/**",
      ".next",
      ".next/**",
      ".env*",
      ".firebase",
      ".firebase/**",
      ".vercel",
      ".vercel/**",
      ".agent",
      ".agent/**",
      ".agents",
      ".agents/**",
      ".claude",
      ".claude/**",
      "coverage",
      "coverage/**",
      "docs",
      "docs/**",
      "scratch",
      "scratch/**",
      "tests",
      "tests/**",
      "playwright-report",
      "playwright-report/**",
      "test-results",
      "test-results/**",
      "MITRA_CREATIVE_REFERENCE_LIBRARY",
      "MITRA_CREATIVE_REFERENCE_LIBRARY/**",
            "public/brand/mascot/mascot-*.png",
      "*.log",
      "*.md"
    ],
    "alwaysDeployFromSource": true
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "database": "(default)"
  },
  "storage": [
    {
      "rules": "storage.rules",
      "bucket": "brainwise-ai-marketing-engine.firebasestorage.app"
    }
  ]
}
