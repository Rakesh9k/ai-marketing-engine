{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"],
      "predeploy": ["npm --prefix functions run build"]
    }
  ],
  "apphosting": {
    "backendId": "mitra-web",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      "functions/node_modules",
      "functions/lib",
      ".git",
      ".next",
      ".env*",
      ".firebase",
      ".vercel",
      "playwright-report",
      "test-results",
      "services/reel-renderer",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
