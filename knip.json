{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/page.{ts,tsx}",
    "src/app/**/route.{ts,tsx}",
    "src/app/**/layout.{ts,tsx}",
    "functions/src/index.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "functions/src/**/*.ts"],
  "ignore": ["**/*.d.ts", "next-env.d.ts", "node_modules/**", ".next/**", "coverage/**"]
}
