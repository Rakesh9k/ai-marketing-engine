rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasBusinessAccess(businessId) {
      return isAuthenticated() &&
        request.auth.token.businessIds.has(businessId);
    }

    function isAgencyMember(agencyId) {
      return isAuthenticated() &&
        request.auth.token.role == 'agency_member' &&
        request.auth.token.agencyId == agencyId;
    }

    // Users collection - own document only
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow read: if isAuthenticated() && request.auth.token.role == 'admin';

      // The users/{uid} document is only ever created server-side (the
      // onUserCreated Auth trigger, via the Admin SDK, which bypasses these
      // rules entirely) — the client never creates its own user doc.
      allow create: if false;

      // CRITICAL: role, businessIds, agencyId, and subscriptionId must
      // never be client-writable. functions/src/functions/business/
      // createBusiness.ts re-reads this exact document to refresh the
      // user's Firebase Auth custom claims (role/businessIds/agencyId) on
      // every business creation. Before this fix, "allow write: if
      // isOwner(userId)" had no field restriction at all, so any
      // authenticated user could write role: 'admin' or
      // agencyId: '<any other agency's id>' directly to their own
      // document via the client SDK, then call createBusiness to have
      // that forged value baked into their real, cryptographically
      // verified custom-claims token — after which every rule and backend
      // check in this project that trusts request.auth.token.role /
      // .agencyId / .businessIds would treat them as an admin and/or a
      // legitimate member of an arbitrary target agency, granting full
      // cross-tenant read/write access to that agency's businesses,
      // brand kits, products, campaigns, assets, and Storage files. This
      // was found and confirmed exploitable via a real Firestore-emulator
      // test before being fixed here (see firestore-security.phase11.test.ts).
      allow update: if isOwner(userId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.businessIds == resource.data.businessIds &&
        request.resource.data.get('agencyId', null) == resource.data.get('agencyId', null) &&
        request.resource.data.get('subscriptionId', null) == resource.data.get('subscriptionId', null);

      allow delete: if false;

      // Social Connections subcollection (Phase 9 Meta integration)
      match /socialConnections/{connectionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Onboarding drafts: the temporary construction layer for a Business Brain
    // (functions/src/onboarding/draftModel.ts). Document id == the owner's uid, so a plain owner
    // check is the whole read rule. Read-only for clients: the only writer is saveOnboardingDraft
    // (Admin SDK), which validates every path/value and stamps provenance server-side — a client
    // could otherwise forge `source: USER_CONFIRMED` / `confirmed: true` on an arbitrary fact.
    match /onboarding_drafts/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Meta server-only collections (Phase 9 Meta integration)
    // Server Admin SDK only — client access completely disallowed
    match /metaCredentials/{connectionId} {
      allow read, write: if false;
    }

    match /metaOAuthStates/{stateId} {
      allow read, write: if false;
    }

    match /pendingMetaSessions/{stateId} {
      allow read, write: if false;
    }

    // Businesses collection. Read-only for clients — create/update go
    // through createBusiness/updateBusiness/updateBusinessBrain (Admin
    // SDK, bypasses these rules). The old unrestricted `allow update: if
    // resource.data.userId == request.auth.uid` let the owner overwrite
    // userId, agencyId, status, or businessBrain directly, bypassing every
    // one of those callables' Zod validation and vertical-consistency
    // checks (A2 in the fix plan) — confirmed no legitimate client caller
    // of businessService.update/create/archive exists (grep found none).
    match /businesses/{businessId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         hasBusinessAccess(businessId) ||
         (request.auth.token.role == 'agency_member' && resource.data.agencyId == request.auth.token.agencyId));
      allow write: if false;
    }

    // Agency collection — agency administrators and members can read their
    // own agency. No agency-creation/management callable exists anywhere in
    // this codebase yet (confirmed by grep: no `collection('agencies')`
    // write outside this rules file), so the previous "allow read, write"
    // granted an owner unrestricted mass-assignment over ownerUserId/
    // members/vertical the moment any agency doc existed (e.g. seeded via
    // the Firebase console for a pilot customer) — including reassigning
    // ownerUserId to hijack the agency, or an agency_member deleting it
    // outright via the blanket "write" grant. Locked to the same
    // read-only-for-clients pattern already used for businesses/brand_kits
    // until a real server-side agency management flow exists to own writes.
    match /agencies/{agencyId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.ownerUserId ||
         isAgencyMember(agencyId));
      allow write: if false;
    }

    // Clients collection — managed within an agency workspace. Like
    // agencies above, no code anywhere creates/reads/updates this
    // collection (confirmed by grep) — it is unimplemented scaffolding.
    // The previous `create` condition checked
    // `request.resource.data.agencyId in request.auth.token.businessIds`,
    // which any authenticated user could satisfy trivially by setting
    // agencyId to one of their own businessIds (a value they fully
    // control), and `update` placed no restriction at all on which fields
    // an owner could change once a doc existed. Locked server-only until a
    // real client management flow is built to validate and own these
    // writes.
    match /clients/{clientId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         hasBusinessAccess(resource.data.businessIds[0]) ||
         (request.auth.token.role == 'agency_member' &&
          resource.data.agencyId == request.auth.token.agencyId));
      allow write: if false;
    }

    // Brand Kits collection (1:1 with business). Read-only for clients —
    // writes must go through createBrandKit/updateBrandKit, which validate
    // colors as hex and enforce the tone enum (Zod schemas the client SDK
    // has no equivalent for).
    match /brand_kits/{businessId} {
      allow read: if isAuthenticated() &&
        exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        (get(/databases/$(database)/documents/businesses/$(businessId)).data.userId == request.auth.uid ||
         hasBusinessAccess(businessId) ||
         (request.auth.token.role == 'agency_member' &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.agencyId == request.auth.token.agencyId));
      allow write: if false;
    }

    // Saved Styles are business-scoped creative preferences. They contain no
    // business facts or brand assets; Cloud Functions own all writes so the
    // server can validate the style and enforce the authenticated tenant.
    match /saved_styles/{styleId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         hasBusinessAccess(resource.data.businessId) ||
         (request.auth.token.role == 'agency_member' &&
          get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.agencyId == request.auth.token.agencyId));
      allow write: if false;
    }

    // Products collection
    match /products/{productId} {
      allow read: if isAuthenticated() &&
        (get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.userId == request.auth.uid ||
         hasBusinessAccess(resource.data.businessId) ||
         (request.auth.token.role == 'agency_member' &&
          get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.agencyId == request.auth.token.agencyId));
      allow create: if isAuthenticated() &&
        request.resource.data.businessId in request.auth.token.businessIds;
      // businessId must not change on update — otherwise an owner could
      // re-point an existing product into another tenant's catalogue
      // (A1 in the fix plan): the old rule only checked the EXISTING
      // doc's business ownership, never that the write kept it there.
      allow update: if isAuthenticated() &&
        get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.userId == request.auth.uid &&
        request.resource.data.businessId == resource.data.businessId;
      allow delete: if isAuthenticated() &&
        get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.userId == request.auth.uid;
    }

    // Campaigns collection
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.businessId in request.auth.token.businessIds ||
         (request.auth.token.role == 'agency_member' &&
          get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.agencyId == request.auth.token.agencyId));
      // Campaigns are created only by generateCampaignStrategy (Admin SDK, bypasses
      // rules). No client code creates them, and an open create let any signed-in user
      // write a campaign already marked status 'verified' with truthCheckStatus 'PASS',
      // forging the Truth Check badge (found by tests/security.tenant.test.ts).
      allow create: if false;

      // Users can update their own campaigns, but NOT the authoritative
      // verification/credit fields. Truth Check status, campaign status
      // (which itself includes the value 'verified'), and credit accounting
      // must be set by Cloud Functions (Admin SDK, which bypasses these
      // rules) only — a client-supplied write can never move a campaign into
      // or out of a verified/completed state, and can never touch
      // metadata.truthCheckStatus, regardless of what value it sends.
      // Beyond the previously-pinned status/credits/truthCheckStatus
      // fields: businessId and userId must never change (re-pointing a
      // campaign to another tenant), and offer/completedAt/
      // metadata.truthCheckResult are also server-authoritative — a client
      // could otherwise edit a verified campaign's price after the fact
      // (A1 in the fix plan) while its truthCheckStatus label still read
      // 'PASS' for the ORIGINAL, no-longer-displayed price.
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.creditsReserved == resource.data.creditsReserved &&
        // Only locked once verified — a draft campaign's offer is
        // legitimately client-editable before generation; the actual
        // threat (A1) is editing price/terms on an ALREADY Truth-Check-
        // verified campaign while its 'verified' status/badge stays shown.
        (resource.data.status != 'verified' ||
         !('offer' in request.resource.data) ||
         !('offer' in resource.data) ||
         request.resource.data.offer == resource.data.offer) &&
        (!('completedAt' in request.resource.data) ||
         !('completedAt' in resource.data) ||
         request.resource.data.completedAt == resource.data.completedAt) &&
        (!('creditsUsed' in request.resource.data) ||
         !('creditsUsed' in resource.data) ||
         request.resource.data.creditsUsed == resource.data.creditsUsed) &&
        (!('metadata' in request.resource.data) ||
         !('metadata' in resource.data) ||
         !request.resource.data.metadata.keys().hasAny(['truthCheckStatus']) ||
         request.resource.data.metadata.truthCheckStatus == resource.data.metadata.truthCheckStatus) &&
        (!('metadata' in request.resource.data) ||
         !('metadata' in resource.data) ||
         !request.resource.data.metadata.keys().hasAny(['truthCheckResult']) ||
         request.resource.data.metadata.truthCheckResult == resource.data.metadata.truthCheckResult);
      allow delete: if false;
    }

    // Campaign Assets collection
    match /campaign_assets/{assetId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.businessId in request.auth.token.businessIds ||
         (request.auth.token.role == 'agency_member' &&
          get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.agencyId == request.auth.token.agencyId));
      // Write only via Cloud Functions
      allow write: if false;
    }

    // Assets collection (general user/business asset uploads)
    match /assets/{assetId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.businessId in request.auth.token.businessIds ||
         (request.auth.token.role == 'agency_member' &&
          get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.agencyId == request.auth.token.agencyId));
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.businessId in request.auth.token.businessIds;
      // businessId/userId must not change on update — otherwise an owner
      // could re-point their own asset into another tenant's business
      // (the same class of bug already fixed for products/{productId}
      // above: the old rule only checked the EXISTING doc's owner, never
      // that the write kept userId/businessId unchanged).
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.businessId == resource.data.businessId;
      allow delete: if false; // Soft delete only
    }

    // Subscriptions collection
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Cloud Functions only
    }

    // Usage collection
    match /usage/{usageId} {
      // The server creates a period's usage doc lazily (signup, or the first
      // credit reservation of the month), so the client's single-doc read of the
      // current period legitimately targets a doc that does not exist yet.
      // `resource.data.userId` on a missing doc evaluates to an error, which
      // Firestore reports as permission-denied and broke every dashboard load at
      // the start of a new month. Allow `get` of a missing doc only for the
      // caller's own id namespace ({uid}_{date}); an existing doc still needs
      // userId to match, and queries (`list`) still need the userId constraint.
      allow get: if isAuthenticated() &&
        (resource == null
          ? usageId.matches(request.auth.uid + '_.*')
          : resource.data.userId == request.auth.uid);
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Cloud Functions only
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Cloud Functions only
    }

    // Analytics Events collection
    match /analytics_events/{eventId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Cloud Functions only
    }

    // Generation Logs collection
    match /generation_logs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Cloud Functions only
    }

    // Account deletion request audit trail (written only by the
    // requestAccountDeletion Cloud Function, which uses a server timestamp)
    match /accountDeletionRequests/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false; // Cloud Functions only
    }

    // Post-MVP collections (rules exist, no MVP access)
    match /partners/{partnerId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /partner_referrals/{referralId} {
      allow read: if isAuthenticated() && resource.data.partnerId == request.auth.uid;
      allow write: if false;
    }

    match /campaign_performance/{campaignId} {
      allow read: if isAuthenticated() &&
        get(/databases/$(database)/documents/campaigns/$(campaignId)).data.userId == request.auth.uid;
      allow write: if false;
    }

    match /whatsapp_leads/{leadId} {
      allow read: if isAuthenticated() &&
        get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.userId == request.auth.uid;
      allow write: if false;
    }

    // Reels collection ("Create a Reel"). Same locked-field pattern as
    // campaigns: status, credits, editPlan, and output fields are
    // authoritative only via Cloud Functions (Admin SDK bypasses these
    // rules) — a client can never self-certify a reel as completed, forge
    // an output URL, or manipulate credit accounting.
    match /reels/{reelId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.businessId in request.auth.token.businessIds ||
         (request.auth.token.role == 'agency_member' &&
          get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.agencyId == request.auth.token.agencyId));
      // Reel projects are only ever created via createReelProject (Cloud
      // Function, Admin SDK) — the client never writes this collection
      // directly, matching campaigns' create-then-server-owns-status model.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // The collections below are never read or written by any client — only
    // Cloud Functions (Admin SDK, which bypasses these rules) touch them.
    // Firestore denies access to any path with no matching rule by default,
    // so these were already inaccessible; these blocks make that trust
    // boundary explicit rather than implicit-by-omission, so a future
    // change to this file can't accidentally open one of them (e.g. by
    // adding a catch-all match) without visibly contradicting a rule
    // already written here.
    match /creative_feedback/{feedbackId} {
      allow read, write: if false;
    }

    match /creative_preferences/{preferenceId} {
      allow read, write: if false;
    }

    match /processed_webhook_events/{eventId} {
      allow read, write: if false;
    }

    match /idempotency_keys/{keyId} {
      allow read, write: if false;
    }

    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    // Publish Jobs collection (Phase 10 Publishing Engine)
    // Read: Allowed for the owning user only
    // Write: Disallowed for client SDK — all job creation and status state transitions go through Cloud Functions (Admin SDK)
    match /publishJobs/{jobId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Scheduled Posts collection (Phase 11 Scheduling Engine)
    // Read: Allowed for the owning user only
    // Write: Disallowed for client SDK — all scheduling state transitions go through Cloud Functions (Admin SDK)
    match /scheduledPosts/{scheduledPostId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Marketing Plans collection (Phase 14 30-Day Marketing Calendar)
    // Read: Allowed for the owning user only
    // Write: Disallowed for client SDK — all plan creation goes through Cloud Functions (Admin SDK)
    match /marketingPlans/{planId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Marketing Calendar Items collection (Phase 14 30-Day Marketing Calendar)
    // Read: Allowed for the owning user only
    // Write: Disallowed for client SDK — all item modifications go through Cloud Functions (Admin SDK)
    match /marketingCalendarItems/{itemId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}

